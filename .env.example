# Monochroma — environment overrides for the Navidrome server.
# Copy to `.env.local` and adjust. These override the matching keys in navidrome.toml.
# `.env.local` is gitignored — never commit real values.

# --- Tidal audio provider (talks to the local hifi-api) ---
ND_TIDAL_ENABLED=true
ND_TIDAL_HIFIAPIURL=http://localhost:8001
# LOSSLESS = CD-quality FLAC via the seekable direct path (browser-playable).
# NOTE: Tidal has been observed to serve AAC under "LOSSLESS" at times; if you
# need guaranteed hi-res, that path is DASH-only and not browser-seekable.
ND_TIDAL_DEFAULTQUALITY=LOSSLESS
